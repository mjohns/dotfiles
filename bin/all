#!/usr/bin/python3

import os
import sys
import subprocess
import concurrent.futures
import functools
from pathlib import Path

def get_extra_filter_string(parts):
  if not parts:
    return ""

  result = ""
  is_inverse = False

  for part in parts:
    if part == ".":
      is_inverse = False
    elif part == ".v":
      is_inverse = True
    else:
      use_strictcase = part.isalpha() and not part.islower()
      inverse_part = "-v" if is_inverse else ""
      i_part = "" if use_strictcase else "-i"
      result = "{} | grep {} {} {}".format(result, i_part, inverse_part, part)

  return result


args = sys.argv[1:]
if not args:
  sys.stderr.write("Missing search term\n")
  sys.exit(1)

regex = args[0]
extra_parts = args[1:]
extra_filters = get_extra_filter_string(extra_parts)


def get_file_name(full):
  index = full.index(":")
  return full[0:index]


def sorter(lhs, rhs):
  try:
    lhs = get_file_name(lhs)
    rhs = get_file_name(rhs)
  except Exception as e:
    pass

  if lhs < rhs:
    return -1
  if lhs == rhs:
    return 0
  return 1


def run_rg(path):
  has_uppercase = any(char.isupper() for char in regex)
  case_insens = "" if has_uppercase else "-i"
  cmd = "rg --ignore-file ~/.rgignore {} -n {} {} {}".format(
      case_insens, regex, path, extra_filters
  )
  result = subprocess.run(
      cmd,
      shell=True,
      capture_output=True,
      text=True,
      errors="replace",
      timeout=60,
  )

  lines = result.stdout.splitlines()
  sorted_lines = sorted(lines, key=functools.cmp_to_key(sorter))
  return sorted_lines

def print_lines(lines):
    for line in lines:
        if line:
            print(line)

if Path.cwd().name != "google3":
  print_lines(run_rg("."))
  sys.exit(0)

paths_file_name = Path.home() / "hg_dirs"
with open(paths_file_name, 'r', encoding='utf-8') as file:
  paths = file.read().splitlines()

with concurrent.futures.ThreadPoolExecutor(max_workers=9) as executor:
  # executor.map guarantees the results are returned in the same order as the input list
  all_results = executor.map(run_rg, paths)

for result in all_results:
  print_lines(result)
